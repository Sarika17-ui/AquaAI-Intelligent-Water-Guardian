# Enable Google Cloud Text-to-Speech fallback when no local Hindi voice is installed.
JAL_RAKSHA_TTS_ENABLED=false
JAL_RAKSHA_HINDI_TTS_VOICE=hi-IN-Neural2-A

# Point to a credential configuration outside the source tree, or use
# `gcloud auth application-default login` for local development.
GOOGLE_APPLICATION_CREDENTIALS=C:\secure\google-cloud-tts-credentials.json
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id

# ThingSpeak Private Channel Proxy (Optional)
# If your ThingSpeak channel is public, no Read API key is required.
# If your channel is PRIVATE, set your Channel ID and Read API Key here
# so the backend can securely proxy feeds without exposing keys in frontend code.
THINGSPEAK_CHANNEL_ID=your-numeric-channel-id
THINGSPEAK_READ_API_KEY=your-private-read-api-key
